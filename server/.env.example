# Server Environment Configuration Template
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Replace with your MongoDB Atlas cluster connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ilfn_db?retryWrites=true&w=majority

# JWT Authentication Secret & Expiration
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRE=7d

# Frontend Client URL for CORS (comma-separated for multiple origins)
CLIENT_URL=http://localhost:5173,https://lost-found-mu-bay.vercel.app,https://lost-found-git-main-jayasris-projects-d2ecf1d8.vercel.app,https://lost-found-39coz1cjo-jayasris-projects-d2ecf1d8.vercel.app

